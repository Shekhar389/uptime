generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum OrganisationStatus {
  active
  inactive
}

model Organisation {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(255)
  logo        String?            @db.VarChar(255)
  description String?            @db.VarChar(1000)
  oid         String?            @unique @db.VarChar(16)
  status      OrganisationStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users User[]

  @@map("organisations")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(255)
  name      String   @db.VarChar(255)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organisation_id        String @db.Uuid
  organisation Organisation @relation(fields: [organisation_id], references: [id])

  @@map("users")
}

model Monitor {
  id              String   @id @default(uuid()) @db.Uuid
  teamId          String   @map("team_id") @db.Uuid
  name            String   @db.VarChar(255)
  url             String   @db.VarChar(1000)
  intervalSeconds Int      @default(60) @map("interval_seconds")
  status          String   @default("up") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  incidents Incident[]

  @@map("monitors")
}

model Incident {
  id         String    @id @default(uuid()) @db.Uuid
  teamId     String    @map("team_id") @db.Uuid
  monitorId  String    @map("monitor_id") @db.Uuid
  title      String    @db.VarChar(255)
  status     String    @default("investigating") @db.VarChar(50)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("incidents")
}
