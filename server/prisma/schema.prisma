generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Team {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(255)
  slug      String     @unique @db.VarChar(255)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  monitors  Monitor[]
  incidents Incident[]

  @@map("teams")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(255)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("users")
}

model Monitor {
  id              String     @id @default(uuid()) @db.Uuid
  teamId          String     @map("team_id") @db.Uuid
  name            String     @db.VarChar(255)
  url             String     @db.VarChar(2048)
  intervalSeconds Int        @default(60) @map("interval_seconds")
  status          String     @default("up") @db.VarChar(50)
  lastCheckedAt   DateTime?  @map("last_checked_at") @db.Timestamptz
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  team            Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  incidents       Incident[]

  @@map("monitors")
}

model Incident {
  id         String    @id @default(uuid()) @db.Uuid
  teamId     String    @map("team_id") @db.Uuid
  monitorId  String    @map("monitor_id") @db.Uuid
  title      String    @db.VarChar(500)
  status     String    @default("investigating") @db.VarChar(50)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  monitor    Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("incidents")
}
